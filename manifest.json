{
  "manifest_version": 3,
  "name": "薯页摘录",
  "version": "0.3.0",
  "description": "提取当前小红书帖文、图片和前 50 条评论，并用自备大模型生成规整概括。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.xhscdn.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "薯页摘录",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
