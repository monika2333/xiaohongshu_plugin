{
  "manifest_version": 3,
  "name": "薯页摘录",
  "version": "0.8.1",
  "description": "提取小红书与微博帖文、图片、评论，用自备大模型生成规整概括；支持多条帖文合并概括与已删帖文截图识别。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "cookies",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://*.weibo.com/*",
    "https://*.sinaimg.cn/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "薯页摘录",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html"
}
